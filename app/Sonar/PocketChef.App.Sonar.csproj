<!--
  Not a real project: it only exists so SonarCloud analyzes the Swift app (issue #138).
  The repo has one SonarCloud project, scanned by SonarScanner for .NET, which ignores
  sonar.sources and only picks up a fixed list of non-.NET languages on its own. Swift
  isn't on that list, but files a project includes as Content are always analyzed. The
  sonarcloud job in .github/workflows/ci.yml builds this between "begin" and "end".
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../Sources/**/*.swift" />
  </ItemGroup>
</Project>
