<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>DensityAPIHost</key>
	<string>$(DENSITY_API_HOST)</string>
	<key>DensityAPIReadKey</key>
	<string>$(DENSITY_API_READ_KEY)</string>
	<!-- The launch screen's background: PCColor.background's cream / ink, so a cold launch
	     doesn't flash the system white / black first (#102). UILaunchScreen_Generation in
	     project.yml can't set a nested key. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
