// Local signing settings for iCloud sync. As Signing.xcconfig.example this is the template:
// copy it to Signing.xcconfig (gitignored), replace the placeholder team ID with yours, then run
// `xcodegen generate`. A Signing.xcconfig still holding the placeholder fails at code signing.
// Find the team ID under Membership details on developer.apple.com/account.
// Xcode must be signed in to that team (Settings > Apple Accounts).
// The app targets include this file (PocketChef.xcconfig), and so do the unit test targets
// (UnitTests.xcconfig) for the team, without the entitlements.

DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_STYLE = Automatic

// iCloud (CloudKit) container iCloud.com.neonpixel.pocketchef plus push for sync.
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = Config/PocketChef-iOS-iCloud.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/PocketChef-macOS-iCloud.entitlements

// Tells the code the entitlement is there (BuildConfiguration.isICloudEnabled).
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) ICLOUD_ENABLED
